  m_Script: {fileID: 11500000, guid: 5f8ed885b8cc55143af96aeebe9a02bb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FinalStoryPanel
  panelRoot: {fileID: 1440393439}
  speakerText: {fileID: 507051205}
  bodyText: {fileID: 883904970}
  nextButton: {fileID: 1364086823}
  confrontationLines:
  - speaker: Felice
    text: "Grete, bu mektubu neden yazd\u0131n? Bana ne s\xF6ylemedin?"
  - speaker: Grete
    text: "Onu burada kar\u015F\u0131la\u015Faca\u011F\u0131 tehlikelerden korumak istedim. Ba\u015Fka se\xE7ene\u011Fim yoktu."
  - speaker: Felice
    text: "Kafka, art\u0131k s\u0131ra sende. Bana ger\xE7ekte ne oldu\u011Funu anlat."
  endingLines:
  - speaker: "\u0130nsan bedenindeki b\xF6cek"
    text: "Ha... ha... ha! Bunca zamand\u0131r benimle konu\u015Fuyordunuz. Ama kimin bedeninde oldu\u011Fumu bile anlamad\u0131n\u0131z!"
  - speaker: Kafka
    text: "Hay\u0131r... Bu benim bedenim. O h\xE2lde... ben kimim?"
